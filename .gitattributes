* text=auto
*.go text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# The web assets are embedded and served verbatim, so they should be the same
# bytes on every platform. Left to "text=auto" they were checked out as CRLF on
# Windows, which changed what the server shipped and broke the asset tests there.
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
